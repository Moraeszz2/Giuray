/* Generated by tools/New-GiurayThemeStyle.ps1 from base.qss and qdarkstyle's per-widget rules. */

/*
 * Giuray theme. Near-black grays, one accent (red #DC2626) for primary actions and active states,
 * Inter (set as the application font, so widgets with their own font keep it), and spacing on an
 * 8 px grid. Flat: no gradients, glows or heavy shadows.
 *
 *   window #0E0E10   surface #161618   raised #202024   border #29292E / #38383F
 *   text #E4E4E7     muted #A1A1AA     dim #71717A
 *   accent #DC2626   hover #EF4444     pressed #B91C1C
 *
 * style.qss is this file followed by the per-widget rules of the controller screens
 * (tools/New-GiurayThemeStyle.ps1 joins them).
 */

/* ---------- Base ---------- */

QWidget {
    background-color: #0E0E10;
    color: #E4E4E7;
    selection-background-color: #DC2626;
    selection-color: #FFFFFF;
    outline: 0;
}

QWidget:disabled {
    color: #52525B;
}

QMainWindow::separator {
    background: #29292E;
    width: 1px;
    height: 1px;
}

QToolTip {
    background-color: #202024;
    color: #E4E4E7;
    border: 1px solid #38383F;
    border-radius: 6px;
    padding: 4px 8px;
}

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #52525B;
}

a {
    color: #F87171;
}

/* ---------- Menu bar and menus ---------- */

QMenuBar {
    background-color: #0E0E10;
    border-bottom: 1px solid #202024;
    padding: 0px 8px;
}

QMenuBar::item {
    background: transparent;
    color: #A1A1AA;
    padding: 8px 8px;
    margin: 0px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #202024;
    color: #FAFAFA;
}

QMenu {
    background-color: #161618;
    border: 1px solid #29292E;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    color: #E4E4E7;
    padding: 6px 24px 6px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #29292E;
}

QMenu::item:disabled {
    color: #52525B;
}

QMenu::separator {
    height: 1px;
    background: #29292E;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

QMenu::indicator:non-exclusive:unchecked,
QMenu::indicator:exclusive:unchecked {
    image: none;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    image: url(:/giuray_rc/check.png);
    background-color: #DC2626;
    border-radius: 4px;
}

QMenu::right-arrow {
    image: url(:/giuray_rc/arrow-right.png);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

QMenu::icon {
    margin-left: 4px;
}

QLabel#VersionLabel {
    color: #71717A;
    font-size: 12px;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #202024;
    color: #E4E4E7;
    border: 1px solid #38383F;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #29292E;
    border-color: #52525B;
}

QPushButton:pressed {
    background-color: #38383F;
}

QPushButton:checked {
    background-color: rgba(220, 38, 38, 0.18);
    border-color: #DC2626;
    color: #FAFAFA;
}

QPushButton:disabled {
    background-color: #161618;
    border-color: #202024;
    color: #52525B;
}

/* Primary actions: the dialog's default button, or any button marked primary. */
QPushButton:default,
QPushButton[primary="true"] {
    background-color: #DC2626;
    border-color: #DC2626;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background-color: #EF4444;
    border-color: #EF4444;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #B91C1C;
    border-color: #B91C1C;
}

QPushButton:default:disabled,
QPushButton[primary="true"]:disabled {
    background-color: #4A1D1D;
    border-color: #4A1D1D;
    color: #A1A1AA;
}

QPushButton:focus {
    border-color: #DC2626;
}

QPushButton::menu-indicator {
    image: url(:/giuray_rc/arrow-down.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
}

QToolButton {
    background-color: transparent;
    color: #A1A1AA;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #202024;
    color: #E4E4E7;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #29292E;
    color: #FAFAFA;
}

QToolButton[popupMode="1"],
QToolButton[popupMode="2"] {
    padding-right: 24px;
}

QToolButton::menu-indicator,
QToolButton::menu-arrow {
    image: url(:/giuray_rc/arrow-down.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    width: 12px;
    height: 12px;
}

QToolButton::menu-button {
    border: none;
    width: 16px;
}

QToolButton#qt_toolbar_ext_button {
    background: transparent;
    border: none;
}

QDialogButtonBox {
    button-layout: 0;
}

/* ---------- Text fields ---------- */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background-color: #161618;
    color: #E4E4E7;
    border: 1px solid #29292E;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #DC2626;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #38383F;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #DC2626;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background-color: #0E0E10;
    color: #52525B;
}

QLineEdit[readOnly="true"] {
    background-color: #0E0E10;
}

/* ---------- Combo and spin boxes ---------- */

QComboBox,
QAbstractSpinBox,
QDateTimeEdit {
    background-color: #161618;
    color: #E4E4E7;
    border: 1px solid #29292E;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 20px;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QDateTimeEdit:hover {
    border-color: #38383F;
}

QComboBox:focus,
QComboBox:on,
QAbstractSpinBox:focus,
QDateTimeEdit:focus {
    border-color: #DC2626;
}

QComboBox:disabled,
QAbstractSpinBox:disabled {
    background-color: #0E0E10;
    color: #52525B;
    border-color: #202024;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/giuray_rc/arrow-down.png);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(:/giuray_rc/arrow-down-disabled.png);
}

QComboBox QAbstractItemView {
    background-color: #161618;
    border: 1px solid #29292E;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
    selection-background-color: #29292E;
    selection-color: #FAFAFA;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 0px 8px;
    border-radius: 4px;
}

QAbstractSpinBox {
    padding-right: 20px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-arrow {
    image: url(:/giuray_rc/arrow-up.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/giuray_rc/arrow-down.png);
    width: 10px;
    height: 10px;
}

/* ---------- Check boxes and radio buttons ---------- */

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #52525B;
    border-radius: 4px;
    background-color: #161618;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover {
    border-color: #A1A1AA;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    background-color: #DC2626;
    border-color: #DC2626;
    image: url(:/giuray_rc/check.png);
}

QCheckBox::indicator:indeterminate {
    background-color: #DC2626;
    border-color: #DC2626;
    image: url(:/giuray_rc/indeterminate.png);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
    background-color: #0E0E10;
    border-color: #38383F;
}

QCheckBox::indicator:checked:disabled {
    background-color: #4A1D1D;
    border-color: #4A1D1D;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #52525B;
    border-radius: 9px;
    background-color: #161618;
}

QRadioButton::indicator:hover {
    border-color: #A1A1AA;
}

QRadioButton::indicator:checked {
    border: 5px solid #DC2626;
    background-color: #FFFFFF;
    width: 8px;
    height: 8px;
}

QRadioButton::indicator:disabled {
    border-color: #38383F;
}

/* ---------- Group boxes, tabs and frames ---------- */

QGroupBox {
    background-color: transparent;
    border: 1px solid #29292E;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0px 4px;
    color: #A1A1AA;
    font-weight: 600;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #29292E;
    background-color: #29292E;
    border: none;
    max-height: 1px;
}

QFrame[frameShape="5"] {
    max-width: 1px;
    max-height: 16777215px;
}

QTabWidget::pane {
    border: 1px solid #29292E;
    border-radius: 8px;
    top: -1px;
    background-color: #0E0E10;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: #A1A1AA;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 0px;
}

QTabBar::tab:hover {
    color: #E4E4E7;
}

QTabBar::tab:selected {
    color: #FAFAFA;
    border-bottom-color: #DC2626;
}

QTabBar::tab:disabled {
    color: #52525B;
}

QTabBar::scroller {
    width: 24px;
}

QTabBar QToolButton {
    background-color: #0E0E10;
}

QSplitter::handle {
    background-color: #202024;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QDockWidget {
    titlebar-close-icon: none;
    color: #A1A1AA;
}

QDockWidget::title {
    background-color: #161618;
    padding: 8px;
}

/* ---------- Lists, trees and tables ---------- */

QAbstractItemView {
    background-color: #0E0E10;
    alternate-background-color: #0E0E10;
    color: #E4E4E7;
    border: none;
    selection-background-color: rgba(220, 38, 38, 0.22);
    selection-color: #FAFAFA;
}

QAbstractItemView::item {
    padding: 4px 8px;
    border: none;
}

QAbstractItemView::item:hover {
    background-color: #161618;
}

QAbstractItemView::item:selected {
    background-color: rgba(220, 38, 38, 0.22);
    color: #FAFAFA;
}

QAbstractItemView::item:selected:!active {
    background-color: #202024;
}

QListView,
QListWidget,
QTreeView,
QTreeWidget,
QTableView,
QTableWidget {
    border: 1px solid #202024;
    border-radius: 8px;
}

QTreeView {
    show-decoration-selected: 1;
}

QTreeView::item {
    border-bottom: 1px solid #1A1A1D;
}

QTreeView::branch {
    background: transparent;
    border-bottom: 1px solid #1A1A1D;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/giuray_rc/arrow-right.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/giuray_rc/arrow-down.png);
}

QTreeView::branch:selected {
    background-color: rgba(220, 38, 38, 0.22);
}

QTableView {
    gridline-color: #202024;
}

QTableCornerButton::section {
    background-color: #0E0E10;
    border: none;
}

QHeaderView {
    background-color: #0E0E10;
    border: none;
}

QHeaderView::section {
    background-color: #0E0E10;
    color: #71717A;
    border: none;
    border-bottom: 1px solid #202024;
    padding: 8px;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: #E4E4E7;
}

QHeaderView::down-arrow {
    image: url(:/giuray_rc/arrow-down.png);
    width: 10px;
    height: 10px;
    subcontrol-position: center right;
    right: 8px;
}

QHeaderView::up-arrow {
    image: url(:/giuray_rc/arrow-up.png);
    width: 10px;
    height: 10px;
    subcontrol-position: center right;
    right: 8px;
}

/* The settings dialogs' category list. */
QListWidget#selectorList,
QTreeWidget#selectorList {
    background-color: #0E0E10;
    border: none;
    border-right: 1px solid #202024;
    border-radius: 0px;
}

/* ---------- Scroll bars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #38383F;
    border-radius: 3px;
    min-height: 32px;
    margin: 2px 3px;
}

QScrollBar::handle:horizontal {
    background-color: #38383F;
    border-radius: 3px;
    min-width: 32px;
    margin: 3px 2px;
}

QScrollBar::handle:hover {
    background-color: #52525B;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---------- Sliders and progress ---------- */

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #38383F;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #38383F;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #DC2626;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background-color: #DC2626;
    border-radius: 2px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: #FAFAFA;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px;
    border-radius: 7px;
}

QSlider::handle:hover {
    background-color: #FFFFFF;
}

QSlider::groove:disabled,
QSlider::sub-page:disabled {
    background-color: #202024;
}

QSlider::handle:disabled {
    background-color: #52525B;
}

QProgressBar {
    background-color: #202024;
    border: none;
    border-radius: 4px;
    color: #E4E4E7;
    text-align: center;
    min-height: 8px;
}

QProgressBar::chunk {
    background-color: #DC2626;
    border-radius: 4px;
}

/* ---------- Game library ---------- */

GameList {
    background-color: #0E0E10;
}

/* The library's bar: search, filters, adding a directory. */
QWidget#LibraryBar {
    background-color: #0E0E10;
}

QWidget#LibraryBar QLabel#LibraryTitle {
    color: #FAFAFA;
    font-size: 16px;
    font-weight: 600;
}

QWidget#LibraryBar QLineEdit#LibrarySearch {
    background-color: #161618;
    border: 1px solid #202024;
    border-radius: 6px;
    padding: 6px 8px;
    min-width: 240px;
}

QWidget#LibraryBar QLineEdit#LibrarySearch:focus {
    border-color: #DC2626;
}

QWidget#LibraryBar QLabel#LibraryResults {
    color: #71717A;
    font-size: 12px;
}

QWidget#LibraryBar QToolButton {
    color: #A1A1AA;
    padding: 6px 8px;
}

QWidget#LibraryBar QToolButton[popupMode="2"] {
    padding-right: 24px;
}

QWidget#LibraryBar QToolButton#LibraryClose {
    padding: 6px;
}

QTreeView#GameTree,
QListView#GameGrid,
QListView#GameCarousel {
    border: none;
    border-radius: 0px;
    background-color: #0E0E10;
}

QTreeView#GameTree::item {
    padding: 4px 8px;
    border-bottom: 1px solid #1A1A1D;
}

QTreeView#GameTree::item:hover,
QTreeView#GameTree::branch:hover {
    background-color: #161618;
}

QTreeView#GameTree::item:selected,
QTreeView#GameTree::branch:selected {
    background-color: rgba(220, 38, 38, 0.20);
}

/* ---------- Status bar ---------- */

QStatusBar {
    background-color: #0E0E10;
    border-top: 1px solid #202024;
    color: #A1A1AA;
    min-height: 32px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #A1A1AA;
    font-size: 12px;
    padding: 0px 8px;
}

QStatusBar QPushButton#TogglableStatusBarButton,
QStatusBar QPushButton#RendererStatusBarButton,
QStatusBar QPushButton#GPUStatusBarButton,
QStatusBar QPushButton#DockingStatusBarButton,
QStatusBar QPushButton#RefreshButton,
QStatusBar QPushButton#MultiplayerStatusButton {
    min-width: 0px;
    min-height: 0px;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #71717A;
    font-size: 12px;
    padding: 4px 8px;
    margin: 0px;
}

QStatusBar QPushButton#TogglableStatusBarButton:hover,
QStatusBar QPushButton#RendererStatusBarButton:hover,
QStatusBar QPushButton#GPUStatusBarButton:hover,
QStatusBar QPushButton#DockingStatusBarButton:hover,
QStatusBar QPushButton#RefreshButton:hover,
QStatusBar QPushButton#MultiplayerStatusButton:hover {
    background-color: #202024;
    color: #FAFAFA;
}

/* On: readable; off: dim. */
QStatusBar QPushButton#TogglableStatusBarButton:checked,
QStatusBar QPushButton#DockingStatusBarButton,
QStatusBar QPushButton#MultiplayerStatusButton {
    color: #D4D4D8;
}

QStatusBar QPushButton#RendererStatusBarButton:checked,
QStatusBar QPushButton#RendererStatusBarButton:!checked {
    color: #D4D4D8;
}

QStatusBar QPushButton#GPUStatusBarButton:!checked {
    color: #D4D4D8;
}

QStatusBar QPushButton#GPUStatusBarButton:checked {
    color: #FCA5A5;
}

QStatusBar QPushButton#MultiplayerStatusButton[state="connected"] {
    color: #E4E4E7;
}

QLabel#TASlabel,
QLabel#FirmwareLabel {
    color: #71717A;
}

QSlider#volume_slider {
    min-height: 24px;
}

/* ---------- Dialogs ---------- */

QDialog,
QMessageBox {
    background-color: #0E0E10;
}

QMessageBox QLabel {
    color: #E4E4E7;
}

QInputDialog QLineEdit {
    min-width: 240px;
}

QCalendarWidget QWidget {
    alternate-background-color: #161618;
}

QCalendarWidget QToolButton {
    color: #E4E4E7;
}

/* ---------- Controller and input screens (sizes from qdarkstyle) ---------- */

QPushButton#buttonRefreshDevices {
    min-width: 23px;
    min-height: 23px;
    max-width: 23px;
    max-height: 23px;
    padding: 0px 0px;
}

QSpinBox#spinboxLStickRange,
QSpinBox#spinboxRStickRange,
QSpinBox#vibrationSpinPlayer1,
QSpinBox#vibrationSpinPlayer2,
QSpinBox#vibrationSpinPlayer3,
QSpinBox#vibrationSpinPlayer4,
QSpinBox#vibrationSpinPlayer5,
QSpinBox#vibrationSpinPlayer6,
QSpinBox#vibrationSpinPlayer7,
QSpinBox#vibrationSpinPlayer8 {
    min-width: 68px;
}

QDialog#ConfigureVibration QGroupBox::indicator,
QGroupBox#motionGroup::indicator,
QGroupBox#vibrationGroup::indicator {
    margin-left: 0px;
}

QDialog#ConfigureVibration QGroupBox::title,
QGroupBox#motionGroup::title,
QGroupBox#vibrationGroup::title {
    spacing: 2px;
    padding-left: 1px;
    padding-right: 1px;
}

QWidget#bottomPerGameInput,
QWidget#topControllerApplet,
QWidget#bottomControllerApplet,
QGroupBox#groupPlayer1Connected:checked,
QGroupBox#groupPlayer2Connected:checked,
QGroupBox#groupPlayer3Connected:checked,
QGroupBox#groupPlayer4Connected:checked,
QGroupBox#groupPlayer5Connected:checked,
QGroupBox#groupPlayer6Connected:checked,
QGroupBox#groupPlayer7Connected:checked,
QGroupBox#groupPlayer8Connected:checked {
    background-color: #161618;
}

QWidget#topPerGameInput,
QWidget#middleControllerApplet {
    background-color: #202024;
}

QWidget#topPerGameInput QComboBox,
QWidget#middleControllerApplet QComboBox {
    width: 120px;
}

QWidget#connectedControllers {
    background: transparent;
}

QWidget#closeButtons {
    background: transparent;
}

QWidget#playersSupported,
QWidget#controllersSupported,
QWidget#controllerSupported1,
QWidget#controllerSupported2,
QWidget#controllerSupported3,
QWidget#controllerSupported4,
QWidget#controllerSupported5,
QWidget#controllerSupported6 {
    border: none;
    background: transparent;
}

QGroupBox#groupPlayer1Connected,
QGroupBox#groupPlayer2Connected,
QGroupBox#groupPlayer3Connected,
QGroupBox#groupPlayer4Connected,
QGroupBox#groupPlayer5Connected,
QGroupBox#groupPlayer6Connected,
QGroupBox#groupPlayer7Connected,
QGroupBox#groupPlayer8Connected {
